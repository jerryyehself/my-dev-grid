# Reference for the environment Cloud Run runs this app with. This file is
# NOT read by the app (Laravel only reads `.env`, which does not exist in
# the container — see Dockerfile) — it exists to document, in one place,
# every `--set-env-vars` / `--set-secrets` value the Cloud Run service needs.
# `.env.example` (local dev, SQLite) is untouched by this file.
#
# Plain values below become `--set-env-vars` in
# .github/workflows/deploy-cloud-run.yml; `# from Secret Manager` values
# become `--set-secrets`. See docs/deployment-gcp.md for full setup steps.

APP_NAME=my-dev-grid
APP_ENV=production
APP_KEY=                          # from Secret Manager: APP_KEY
APP_DEBUG=false
APP_URL=                          # the Cloud Run service URL (or custom domain), set after first deploy

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Cloud Run captures container stdout/stderr as logs; there is no persistent
# disk to write storage/logs/laravel.log to, so log to stderr instead of the
# "stack"/"single" file channels used in local dev.
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Cloud SQL for PostgreSQL, reached over the Cloud SQL Auth Proxy sidecar
# that `--add-cloudsql-instances` attaches to the Cloud Run service. Postgres
# (unlike MySQL) accepts a socket directory directly as `host`, so no
# separate `unix_socket` config key is needed — config/database.php's
# existing `pgsql` connection works unchanged.
DB_CONNECTION=pgsql
DB_HOST=/cloudsql/PROJECT_ID:asia-east1:INSTANCE_NAME
DB_PORT=5432
DB_DATABASE=my_dev_grid
DB_USERNAME=my_dev_grid_app
DB_PASSWORD=                      # from Secret Manager: DB_PASSWORD

# No local disk to survive a restart, so keep these on "database" (same
# driver local dev already uses) instead of "file" — no Redis needed for
# this app's current scale.
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log

GITHUB_TOKEN=                     # from Secret Manager: GITHUB_TOKEN
