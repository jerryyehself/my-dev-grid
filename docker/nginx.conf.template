worker_processes auto;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    keepalive_timeout 65;
    client_max_body_size 20m;

    # Cloud Run collects container stdout/stderr as logs; there's no
    # persistent disk to write access/error logs to.
    #
    # The access log uses nginx's built-in "combined" format with one change:
    # the request line is logged without its query string (issue #103), so
    # values like the OAuth callback's ?code=&state= never reach Cloud
    # Logging. $request_uri is the original request target as the client
    # sent it; the map keeps everything before the first "?". ($uri can't be
    # used here: try_files rewrites it to /index.php before the log line is
    # written.)
    map $request_uri $request_path_only {
        "~^(?<path_only>[^?]*)" $path_only;
    }
    log_format combined_no_query '$remote_addr - $remote_user [$time_local] '
                                 '"$request_method $request_path_only $server_protocol" '
                                 '$status $body_bytes_sent '
                                 '"$http_referer" "$http_user_agent"';
    access_log /dev/stdout combined_no_query;
    error_log /dev/stderr warn;

    server {
        # Substituted from $PORT by docker/entrypoint.sh at container start
        # (Cloud Run assigns the port the container must listen on).
        listen ${PORT} default_server;
        server_name _;

        root /var/www/html/public;
        index index.php;

        location / {
            try_files $uri $uri/ /index.php?$query_string;
        }

        location = /favicon.ico { access_log off; log_not_found off; }
        location = /robots.txt  { access_log off; log_not_found off; }

        location ~ \.php$ {
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_index index.php;
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param PATH_INFO $fastcgi_path_info;
            fastcgi_read_timeout 300;
            fastcgi_buffering off;
        }

        # Deny everything under a dot-directory except /.well-known/ (ACME
        # challenges etc.).
        location ~ /\.(?!well-known).* {
            deny all;
        }
    }
}
